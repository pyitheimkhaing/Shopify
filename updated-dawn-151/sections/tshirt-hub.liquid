{{ 'ci-base.css' | asset_url | stylesheet_tag }}
{{ 'customink-exact.css' | asset_url | stylesheet_tag }}
{{ 'tshirt-hub.css' | asset_url | stylesheet_tag }}
{{ 'tshirt-hub-design.css' | asset_url | stylesheet_tag }}

<section class="tshirt-hub" id="TshirtHub-{{ section.id }}">
  <div class="sb-Wrapper">
    <!-- A. Breadcrumb & Page Toolbar -->
    <div class="pc-Header">
      <nav class="pc-Breadcrumbs" aria-label="Breadcrumb">
        <ol class="pc-Breadcrumbs-wrapper" itemscope itemtype="https://schema.org/BreadcrumbList">
          <li class="pc-BreadcrumbItem" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" itemprop="item">
              <span itemprop="name">All Products</span>
            </a>
            <meta itemprop="position" content="1">
          </li>
          <li class="pc-BreadcrumbItem" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <span class="pc-Breadcrumbs-title" itemprop="name">T-shirts</span>
            <meta itemprop="position" content="2">
          </li>
        </ol>
      </nav>

      <div class="pc-ToolBar">
        <div class="pc-ToolBar-section">
          <div class="pc-ToolBar-header">
            <h1 class="pc-ToolBar-header-title">
              {{ section.settings.page_title | default: 'Custom T-shirts' }}
            </h1>
          </div>
        </div>
      </div>
    </div>

    <!-- B. Promotional Hero Banner -->
    <div class="pc-Subcategories-CatHero" id="category-hero">
      <div class="pc-PromoBanner" style="--cat-promo-bg: {{ section.settings.promo_bg | default: '#C67DBC' }};">
        <div class="pc-PromoBanner-copy">
          <h2>
            {%- if section.settings.promo_heading != blank -%}
              {{ section.settings.promo_heading | replace: 'shirts for', 'shirts<br class="desktop-br"> for' }}
            {%- else -%}
              Design custom shirts<br class="desktop-br"> for your team or event.
            {%- endif -%}
          </h2>
          <p>{{ section.settings.promo_subheading | default: 'High-quality printing, no minimums on select styles, and fast, reliable delivery.' }}</p>
          <a
            class="button-promo"
            href="{{ section.settings.promo_link | default: routes.collections_url | append: '/t-shirts' }}"
          >
            <span>{{ section.settings.promo_button | default: 'Shop All T-Shirts' }}</span>
            <svg class="button-promo-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
        <div class="pc-PromoBanner-imageWrap">
          <picture class="pc-PromoBanner-picture">
            <source media="(max-width: 768px)" srcset="{{ 'ci-hero-tshirts-mobile.png' | asset_url }}">
            <img
              src="{{ 'ci-hero-tshirts-desktop.png' | asset_url }}"
              alt="{{ section.settings.promo_heading | default: 'Design custom shirts for your team or event.' | escape }}"
              class="pc-PromoBanner-image"
              loading="eager"
              width="528"
              height="398"
            >
          </picture>
        </div>
      </div>
    </div>

    <!-- B2. Featured Products -->
    {%- if section.settings.show_featured -%}
      {%- liquid
        assign fp = section.settings.featured_product
        assign f_title = fp.title | default: section.settings.featured_title
        assign f_details_link = section.settings.featured_details_link | default: fp.url | default: '/designlab'
        assign f_design_link = section.settings.featured_design_link | default: fp.url | default: '/designlab'
        assign f_image = fp.featured_image | default: section.settings.featured_image
        assign f_max_swatches = 8
        assign f_colors = section.blocks | where: 'type', 'featured_color'
        assign f_has_colors = false
        assign f_color_opt = nil
        assign f_first_name = ''
        if f_colors.size > 0
          assign f_has_colors = true
          assign f_first = f_colors | first
          assign f_first_name = f_first.settings.name
          if f_first.settings.image != blank
            assign f_image = f_first.settings.image | image_url: width: 640
          elsif f_first.settings.asset_image != blank
            assign f_image = f_first.settings.asset_image | asset_url
          endif
        elsif fp != blank
          for option in fp.options_with_values
            assign opt_name = option.name | downcase
            if opt_name contains 'color' or opt_name contains 'colour'
              assign f_color_opt = option
              break
            endif
          endfor
          if f_color_opt != nil and f_color_opt.values.size > 0
            assign f_opt_index = f_color_opt.position | minus: 1
            assign f_any_img = false
            for variant in fp.variants
              if variant.featured_image != blank
                assign f_any_img = true
                break
              endif
            endfor
            assign f_elig_count = 0
            for value in f_color_opt.values
              assign v_img = ''
              for variant in fp.variants
                if variant.options[f_opt_index] == value.name and variant.featured_image != blank
                  assign v_img = variant.featured_image | image_url: width: 640
                  break
                endif
              endfor
              if v_img != '' or f_any_img == false
                assign f_elig_count = f_elig_count | plus: 1
                if f_elig_count == 1
                  assign f_first_name = value.name
                  if v_img != ''
                    assign f_image = v_img
                  else
                    assign f_image = fp.featured_image | image_url: width: 640
                  endif
                endif
              endif
            endfor
            if f_elig_count > 0
              assign f_has_colors = true
            endif
          endif
        endif
      -%}
      {%- if f_title != blank -%}
        <section class="pc-Featured" id="featured-products">
          {%- if section.settings.featured_heading != blank -%}
            <h2 class="pc-Featured-heading">{{ section.settings.featured_heading }}</h2>
          {%- endif -%}
          <article class="pc-FeaturedCard">
            <a class="pc-FeaturedCard-image" href="{{ f_details_link }}" aria-label="{{ f_title | escape }}">
              {%- if f_image != blank -%}
                {%- if f_has_colors -%}
                  <img src="{{ f_image }}" alt="{{ f_title | escape }}" loading="lazy" width="220" height="220" data-featured-img>
                {%- else -%}
                  <img src="{{ f_image | image_url: width: 480 }}" alt="{{ f_title | escape }}" loading="lazy" width="220" height="220">
                {%- endif -%}
              {%- endif -%}
              {%- if section.settings.featured_badge != blank -%}
                <span class="pc-FeaturedCard-badge">{{ section.settings.featured_badge }}</span>
              {%- endif -%}
            </a>
            <div class="pc-FeaturedCard-body">
              <h3 class="pc-FeaturedCard-title">{{ f_title }}</h3>
              {%- if f_colors.size > 0 -%}
                <div class="pc-FeaturedCard-colors" data-featured-colors>
                  <p class="pc-FeaturedCard-colorname">Color: <strong data-featured-colorname>{{ f_first_name }}</strong></p>
                  <ul class="pc-FeaturedCard-swatches" role="radiogroup" aria-label="Color">
                    {%- for block in f_colors -%}
                      {%- liquid
                        assign c_img = ''
                        if block.settings.image != blank
                          assign c_img = block.settings.image | image_url: width: 640
                        elsif block.settings.asset_image != blank
                          assign c_img = block.settings.asset_image | asset_url
                        endif
                      -%}
                      <li class="pc-FeaturedCard-swatchitem{% if forloop.index > f_max_swatches %} is-extra{% endif %}" {{ block.shopify_attributes }}>
                        <button type="button" class="pc-FeaturedCard-swatch pc-FeaturedCard-swatch--btn{% if forloop.first %} is-selected{% endif %}" role="radio" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ block.settings.name | escape }}" title="{{ block.settings.name | escape }}" data-color-name="{{ block.settings.name | escape }}" data-color-image="{{ c_img }}" style="background: {{ block.settings.color | default: '#d6d8db' }};"></button>
                      </li>
                    {%- endfor -%}
                    {%- assign c_extra = f_colors.size | minus: f_max_swatches -%}
                    {%- if c_extra > 0 -%}
                      <li class="pc-FeaturedCard-moreitem"><button type="button" class="pc-FeaturedCard-more pc-FeaturedCard-more--btn" aria-expanded="false" data-featured-more data-more-label="+{{ c_extra }}">+{{ c_extra }}</button></li>
                    {%- endif -%}
                  </ul>
                </div>
              {%- elsif f_has_colors -%}
                <div class="pc-FeaturedCard-colors" data-featured-colors>
                  <p class="pc-FeaturedCard-colorname">{{ f_color_opt.name }}: <strong data-featured-colorname>{{ f_first_name }}</strong></p>
                  <ul class="pc-FeaturedCard-swatches" role="radiogroup" aria-label="{{ f_color_opt.name | escape }}">
                    {%- assign c_n = 0 -%}
                    {%- for value in f_color_opt.values -%}
                      {%- liquid
                        assign c_img = ''
                        for variant in fp.variants
                          if variant.options[f_opt_index] == value.name and variant.featured_image != blank
                            assign c_img = variant.featured_image | image_url: width: 640
                            break
                          endif
                        endfor
                        assign c_show = false
                        if c_img != '' or f_any_img == false
                          assign c_show = true
                        endif
                        if c_show and c_img == ''
                          assign c_img = fp.featured_image | image_url: width: 640
                        endif
                        assign c_key = value.name | downcase | strip
                        if value.swatch.image
                          assign sw_img = value.swatch.image | image_url: width: 50
                          assign c_bg = 'url(' | append: sw_img | append: ') center / cover'
                        elsif value.swatch.color
                          assign c_bg = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                        else
                          case c_key
                            when 'white'
                              assign c_bg = '#f1f1f1'
                            when 'black'
                              assign c_bg = '#292929'
                            when 'blue'
                              assign c_bg = '#1c5ba3'
                            when 'navy'
                              assign c_bg = '#1f2e44'
                            when 'red'
                              assign c_bg = '#c8202f'
                            when 'grey' or 'gray'
                              assign c_bg = '#bababc'
                            when 'green'
                              assign c_bg = '#2f6b3a'
                            else
                              assign c_bg = c_key | handleize | remove: '-'
                          endcase
                        endif
                      -%}
                      {%- if c_show -%}
                        {%- assign c_n = c_n | plus: 1 -%}
                        <li class="pc-FeaturedCard-swatchitem{% if c_n > f_max_swatches %} is-extra{% endif %}">
                          <button type="button" class="pc-FeaturedCard-swatch pc-FeaturedCard-swatch--btn{% if c_n == 1 %} is-selected{% endif %}" role="radio" aria-checked="{% if c_n == 1 %}true{% else %}false{% endif %}" aria-label="{{ value.name | escape }}" title="{{ value.name | escape }}" data-color-name="{{ value.name | escape }}" data-color-image="{{ c_img }}" style="background: {{ c_bg }};"></button>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign c_extra = f_elig_count | minus: f_max_swatches -%}
                    {%- if c_extra > 0 -%}
                      <li class="pc-FeaturedCard-moreitem"><button type="button" class="pc-FeaturedCard-more pc-FeaturedCard-more--btn" aria-expanded="false" data-featured-more data-more-label="+{{ c_extra }}">+{{ c_extra }}</button></li>
                    {%- endif -%}
                  </ul>
                </div>
              {%- endif -%}
              <div class="pc-FeaturedCard-meta">
                {%- render 'hub-rating', product: fp, default_count: section.settings.featured_rating_count -%}
                {%- if section.settings.featured_note != blank -%}
                  <span class="pc-FeaturedCard-note">{{ section.settings.featured_note }}</span>
                {%- endif -%}
                {%- if section.settings.featured_details_label != blank -%}
                  <a class="pc-FeaturedCard-details" href="{{ f_details_link }}">{{ section.settings.featured_details_label }}</a>
                {%- endif -%}
              </div>
              {%- if section.settings.featured_design_label != blank -%}
                <a class="pc-FeaturedCard-btn" href="{{ f_design_link }}">{{ section.settings.featured_design_label }}</a>
              {%- endif -%}
            </div>
          </article>
          {%- if f_has_colors -%}
            <script>
              (function () {
                var root = document.getElementById('featured-products');
                if (!root) return;
                var img = root.querySelector('[data-featured-img]');
                var label = root.querySelector('[data-featured-colorname]');
                var box = root.querySelector('[data-featured-colors]');
                if (!img || !box) return;
                var title = {{ f_title | json }};
                var buttons = Array.prototype.slice.call(box.querySelectorAll('.pc-FeaturedCard-swatch--btn'));
                buttons.forEach(function (b) {
                  var m = (window.getComputedStyle(b).backgroundColor || '').match(/[\d.]+/g);
                  if (m && m.length >= 3 && !(m.length > 3 && +m[3] === 0)) b.classList.toggle('is-light', (0.299 * m[0] + 0.587 * m[1] + 0.114 * m[2]) / 255 > 0.62);
                });
                function select(btn) {
                  buttons.forEach(function (b) {
                    var on = b === btn;
                    b.classList.toggle('is-selected', on);
                    b.setAttribute('aria-checked', on ? 'true' : 'false');
                    b.tabIndex = on ? 0 : -1;
                  });
                  var name = btn.getAttribute('data-color-name');
                  var src = btn.getAttribute('data-color-image');
                  if (label) label.textContent = name;
                  if (src && img.getAttribute('src') !== src) {
                    img.classList.add('is-swapping');
                    var next = new Image();
                    next.onload = next.onerror = function () {
                      img.src = src;
                      img.alt = title + ' - ' + name;
                      img.classList.remove('is-swapping');
                    };
                    next.src = src;
                  }
                }
                buttons.forEach(function (btn, i) {
                  btn.tabIndex = i === 0 ? 0 : -1;
                  btn.addEventListener('click', function () { select(btn); });
                  btn.addEventListener('keydown', function (e) {
                    var d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
                    if (!d) return;
                    e.preventDefault();
                    var visible = buttons.filter(function (b) { return b.offsetParent !== null; });
                    var n = visible[(visible.indexOf(btn) + d + visible.length) % visible.length];
                    n.focus();
                    select(n);
                  });
                });
                var more = box.querySelector('[data-featured-more]');
                if (more) {
                  more.addEventListener('click', function () {
                    var open = box.classList.toggle('is-expanded');
                    more.setAttribute('aria-expanded', open ? 'true' : 'false');
                    more.textContent = open ? 'Less' : more.getAttribute('data-more-label');
                  });
                }
              })();
            </script>
          {%- endif -%}
        </section>
      {%- endif -%}
    {%- endif -%}

    <!-- C. Category Grid: Shop By Style -->
    <div class="pc-CatCards--grouped pc-CatCards--grouped-style">
      {% assign style_tiles_count = 0 %}
      {% for block in section.blocks %}
        {% if block.settings.group == 'style' and block.settings.title != blank and block.settings.link != blank %}
          {% assign style_tiles_count = style_tiles_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if style_tiles_count > 0 %}
        {% liquid
          assign tiles_mod_class = ''
          if style_tiles_count == 3
            assign tiles_mod_class = ' pc-CatCards-group-tiles--3'
          elsif style_tiles_count >= 5
            assign tiles_mod_class = ' pc-CatCards-group-tiles--5'
          endif
        %}
        <div class="pc-CatCards-group" id="Group-style">
          <h2 class="pc-CatCards-group-label">Shop By Style</h2>
          <div class="pc-CatCards-group-tiles{{ tiles_mod_class }}">
            {% for block in section.blocks %}
              {% if block.settings.group == 'style' and block.settings.title != blank and block.settings.link != blank %}
                {% liquid
                  assign block_title_lower = block.settings.title | downcase
                  assign tile_img_src = ''

                  if block.settings.image != blank
                    assign tile_img_src = block.settings.image | image_url: width: 400
                  elsif block_title_lower contains 'short sleeve'
                    assign tile_img_src = 'ci-cat-shortsleeve.jpg' | asset_url
                  elsif block_title_lower contains 'long sleeve'
                    assign tile_img_src = 'ci-cat-longsleeve.jpg' | asset_url
                  elsif block_title_lower contains 'tank' or block_title_lower contains 'sleeveless'
                    assign tile_img_src = 'ci-cat-tanktops.jpg' | asset_url
                  else
                    assign tile_img_src = 'ci-cat-shortsleeve.jpg' | asset_url
                  endif
                %}

                <div class="pc-CatCard--V2" {{ block.shopify_attributes }}>
                  <div class="pc-CatCard--V2-content">
                    <a class="pc-CatCard--V2-link" href="{{ block.settings.link }}">
                      <div class="pc-CatCard--V2-image">
                        <img
                          class="pc-CatCard--V2-img"
                          src="{{ tile_img_src }}"
                          alt="{{ block.settings.title | escape }}"
                          loading="lazy"
                          width="200"
                          height="200"
                        >
                        {% if block.settings.badge != blank %}
                          <span class="pc-CatCards-group-badge">{{ block.settings.badge }}</span>
                        {% endif %}
                      </div>
                      <h3 class="pc-CatCard--V2-name">{{ block.settings.title }}</h3>
                    </a>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>

    <!-- E. Category Grids (Shop By Fabric, Shop By Fit, Shop By Collection) -->
    <div class="pc-CatCards--grouped">
      {% assign group_keys = 'fabric|fit|collection' | split: '|' %}
      {% assign group_labels = 'Shop By Fabric|Shop By Fit|Shop By Collection' | split: '|' %}

      {% for key in group_keys %}
        {% assign group_tiles_count = 0 %}
        {% for block in section.blocks %}
          {% if block.settings.group == key and block.settings.title != blank and block.settings.link != blank %}
            {% assign group_tiles_count = group_tiles_count | plus: 1 %}
          {% endif %}
        {% endfor %}

        {% if group_tiles_count > 0 %}
          {% liquid
            assign tiles_mod_class = ''
            if group_tiles_count == 3
              assign tiles_mod_class = ' pc-CatCards-group-tiles--3'
            elsif group_tiles_count >= 5
              assign tiles_mod_class = ' pc-CatCards-group-tiles--5'
            endif
          %}
          <div class="pc-CatCards-group" id="Group-{{ key }}">
            <h2 class="pc-CatCards-group-label">{{ group_labels[forloop.index0] }}</h2>
            <div class="pc-CatCards-group-tiles{{ tiles_mod_class }}">
              {% for block in section.blocks %}
                {% if block.settings.group == key and block.settings.title != blank and block.settings.link != blank %}
                  {% liquid
                    assign block_title_lower = block.settings.title | downcase
                    assign tile_img_src = ''

                    if block.settings.image != blank
                      assign tile_img_src = block.settings.image | image_url: width: 400
                    elsif block_title_lower contains 'short sleeve'
                      assign tile_img_src = 'ci-cat-shortsleeve.jpg' | asset_url
                    elsif block_title_lower contains 'long sleeve'
                      assign tile_img_src = 'ci-cat-longsleeve.jpg' | asset_url
                    elsif block_title_lower contains 'tank' or block_title_lower contains 'sleeveless'
                      assign tile_img_src = 'ci-cat-tanktops.jpg' | asset_url
                    elsif block_title_lower contains 'premium'
                      assign tile_img_src = 'ci-cat-premium.jpg' | asset_url
                    elsif block_title_lower contains 'tri-blend' or block_title_lower contains 'triblend'
                      assign tile_img_src = 'ci-cat-soft-triblend.jpg' | asset_url
                    elsif block_title_lower contains 'performance'
                      assign tile_img_src = 'ci-cat-performance.jpg' | asset_url
                    elsif block_title_lower contains 'heavyweight'
                      assign tile_img_src = 'ci-cat-heavyweight.jpg' | asset_url
                    elsif block_title_lower contains 'sustainable'
                      assign tile_img_src = 'ci-cat-sustainable.png' | asset_url
                    elsif block_title_lower contains 'unisex'
                      assign tile_img_src = 'ci-cat-unisex.png' | asset_url
                    elsif block_title_lower contains 'women' or block_title_lower contains 'ladies'
                      assign tile_img_src = 'ci-cat-womens.jpg' | asset_url
                    elsif block_title_lower contains 'kid' or block_title_lower contains 'youth'
                      assign tile_img_src = 'ci-cat-kids.jpg' | asset_url
                    elsif block_title_lower contains 'tall'
                      assign tile_img_src = 'ci-cat-tall.jpg' | asset_url
                    elsif block_title_lower contains 'no minimum'
                      assign tile_img_src = 'ci-cat-no-minimum.jpg' | asset_url
                    elsif block_title_lower contains 'usa' or block_title_lower contains 'america'
                      assign tile_img_src = 'ci-cat-made-in-usa.jpg' | asset_url
                    elsif block_title_lower contains 'tie-dye' or block_title_lower contains 'tiedye'
                      assign tile_img_src = 'ci-cat-tiedye.jpg' | asset_url
                    elsif block_title_lower contains 'new'
                      assign tile_img_src = 'ci-cat-new.png' | asset_url
                    elsif block_title_lower contains 'canada'
                      assign tile_img_src = 'ci-cat-canada.jpg' | asset_url
                    else
                      assign tile_img_src = 'ci-cat-shortsleeve.jpg' | asset_url
                    endif
                  %}

                  <div class="pc-CatCard--V2" {{ block.shopify_attributes }}>
                    <div class="pc-CatCard--V2-content">
                      <a class="pc-CatCard--V2-link" href="{{ block.settings.link }}">
                        <div class="pc-CatCard--V2-image">
                          <img
                            class="pc-CatCard--V2-img"
                            src="{{ tile_img_src }}"
                            alt="{{ block.settings.title | escape }}"
                            loading="lazy"
                            width="200"
                            height="200"
                          >

                          {% if block.settings.badge != blank %}
                            <span class="pc-CatCards-group-badge">{{ block.settings.badge }}</span>
                          {% elsif block_title_lower contains 'sustainable' %}
                            <img
                              alt="Sustainable"
                              class="pc-CatCards-group-sustainable"
                              src="{{ 'ci-cat-sustainable-badge.png' | asset_url }}"
                              width="28"
                              height="28"
                              loading="lazy"
                            >
                          {% elsif block_title_lower contains 'usa' %}
                            <div class="pc-CatCard--V2-flag pc-CatCard-flag--us" title="Made in USA">
                              <svg viewBox="0 0 60 30" width="60" height="30" aria-hidden="true">
                                <rect width="60" height="30" fill="#b22234"/>
                                <rect y="2.31" width="60" height="2.31" fill="#ffffff"/>
                                <rect y="6.92" width="60" height="2.31" fill="#ffffff"/>
                                <rect y="11.54" width="60" height="2.31" fill="#ffffff"/>
                                <rect y="16.15" width="60" height="2.31" fill="#ffffff"/>
                                <rect y="20.77" width="60" height="2.31" fill="#ffffff"/>
                                <rect y="25.38" width="60" height="2.31" fill="#ffffff"/>
                                <rect width="24" height="16.15" fill="#3c3b6e"/>
                                <g fill="#ffffff">
                                  <circle cx="4" cy="3" r="0.9"/>
                                  <circle cx="10" cy="3" r="0.9"/>
                                  <circle cx="16" cy="3" r="0.9"/>
                                  <circle cx="22" cy="3" r="0.9"/>
                                  <circle cx="7" cy="6" r="0.9"/>
                                  <circle cx="13" cy="6" r="0.9"/>
                                  <circle cx="19" cy="6" r="0.9"/>
                                  <circle cx="4" cy="9" r="0.9"/>
                                  <circle cx="10" cy="9" r="0.9"/>
                                  <circle cx="16" cy="9" r="0.9"/>
                                  <circle cx="22" cy="9" r="0.9"/>
                                  <circle cx="7" cy="12" r="0.9"/>
                                  <circle cx="13" cy="12" r="0.9"/>
                                  <circle cx="19" cy="12" r="0.9"/>
                                </g>
                              </svg>
                            </div>
