                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button
              type="button"
              class="pc-Carousel-arrow pc-Carousel-arrow--next"
              id="TrendingNext-{{ section.id }}"
              aria-label="Next products"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </div>

        <div class="pc-TrendingTrack" id="TrendingTrack-{{ section.id }}">
          {% assign t_count = 0 %}
          {% for product in trending_col.products %}
            {% assign p_title_lower = product.title | downcase %}
            {% unless p_title_lower contains 'blanket' or product.tags contains 'blanket' or p_title_lower contains 'banner' %}
              {% assign t_count = t_count | plus: 1 %}
              {% if t_count <= 12 %}
                {%- liquid
                  assign t_color_opt = nil
                  assign t_colors = 0
                  assign t_has_unit = false
                  assign t_unit_price = 0
                  assign t_qty = section.settings.price_break_quantity | default: 100
                  for option in product.options_with_values
                    assign opt_name = option.name | downcase
                    if opt_name contains 'color' or opt_name contains 'colour'
                      assign t_color_opt = option
                      break
                    endif
                  endfor
                  if t_color_opt != nil
                    assign t_opt_index = t_color_opt.position | minus: 1
                    for value in t_color_opt.values
                      for variant in product.variants
                        if variant.options[t_opt_index] == value.name and variant.featured_image != blank
                          assign t_colors = t_colors | plus: 1
                          break
                        endif
                      endfor
                    endfor
                  endif
                  assign t_variant = product.selected_or_first_available_variant
                  if t_variant.quantity_price_breaks.size > 0
                    assign t_breaks = t_variant.quantity_price_breaks | sort: 'minimum_quantity'
                    for pb in t_breaks
                      if pb.minimum_quantity <= t_qty
                        assign t_has_unit = true
                        assign t_unit_price = pb.price
                      endif
                    endfor
                  endif
                  if t_has_unit == false
                    assign t_has_unit = true
                    assign t_unit_price = product.price
                  endif
                  assign t_delivery = product.metafields.custom.delivery_text.value | default: section.settings.trending_delivery_label
                -%}
                <div class="pc-TrendingCard" data-trending-card>
                  <div class="pc-TrendingCard-media">
                    <a href="{{ product.url }}" class="pc-TrendingCard-imageWrap">
                      <img
                        src="{{ product.featured_image | image_url: width: 400 }}"
                        alt="{{ product.title | escape }}"
                        loading="lazy"
                        width="220"
                        height="220"
                        data-trending-img
                      >
                    </a>
                    <button type="button" class="pc-TrendingCard-fav" aria-pressed="false" aria-label="Favorite" data-trending-fav="{{ product.handle }}">
                      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M12 20.7l-1.2-1.1C6 15.3 3 12.5 3 9a4.8 4.8 0 0 1 4.9-4.9c1.6 0 3.1.8 4.1 2 1-1.2 2.5-2 4.1-2A4.8 4.8 0 0 1 21 9c0 3.5-3 6.3-7.8 10.6L12 20.7z"/></svg>
                    </button>
                  </div>
                  <div class="pc-TrendingCard-info">
                    {%- if t_colors > 1 -%}
                      <div class="pc-TrendingCard-colors" data-trending-colors>
                        <ul class="pc-TrendingCard-swatches" role="radiogroup" aria-label="{{ t_color_opt.name | escape }}">
                          {%- assign t_n = 0 -%}
                          {%- for value in t_color_opt.values -%}
                            {%- liquid
                              assign c_img = ''
                              for variant in product.variants
                                if variant.options[t_opt_index] == value.name and variant.featured_image != blank
                                  assign c_img = variant.featured_image | image_url: width: 400
                                  break
                                endif
                              endfor
                              assign c_key = value.name | downcase | strip
                              if value.swatch.image
                                assign sw_img = value.swatch.image | image_url: width: 50
                                assign c_bg = 'url(' | append: sw_img | append: ') center / cover'
                              elsif value.swatch.color
                                assign c_bg = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                              else
                                case c_key
                                  when 'white'
                                    assign c_bg = '#f1f1f1'
                                  when 'black'
                                    assign c_bg = '#292929'
                                  when 'blue'
                                    assign c_bg = '#1c5ba3'
                                  when 'navy'
                                    assign c_bg = '#1f2e44'
                                  when 'red'
                                    assign c_bg = '#c8202f'
                                  when 'grey' or 'gray'
                                    assign c_bg = '#bababc'
                                  when 'green'
                                    assign c_bg = '#2f6b3a'
                                  else
                                    assign c_bg = c_key | handleize | remove: '-'
                                endcase
                              endif
                            -%}
                            {%- if c_img != '' -%}
                              {%- assign t_n = t_n | plus: 1 -%}
                              <li class="pc-TrendingCard-swatchitem{% if t_n > 8 %} is-extra{% endif %}">
                                <button type="button" class="pc-TrendingCard-swatch{% if t_n == 1 %} is-selected{% endif %}" role="radio" aria-checked="{% if t_n == 1 %}true{% else %}false{% endif %}" aria-label="{{ value.name | escape }}" title="{{ value.name | escape }}" data-color-name="{{ value.name | escape }}" data-color-image="{{ c_img }}" style="background: {{ c_bg }};"></button>
                              </li>
                            {%- endif -%}
                          {%- endfor -%}
                          {%- assign t_extra = t_colors | minus: 8 -%}
                          {%- if t_extra > 0 -%}
                            <li class="pc-TrendingCard-moreitem"><button type="button" class="pc-TrendingCard-more" aria-expanded="false" data-trending-more data-more-label="+{{ t_extra }}">+{{ t_extra }}</button></li>
                          {%- endif -%}
                        </ul>
                      </div>
                    {%- endif -%}
                    <a href="{{ product.url }}" class="pc-TrendingCard-title">
                      {{ product.title }}
                    </a>
                    {%- render 'hub-rating', product: product, default_count: section.settings.trending_rating_count -%}
                    {%- if t_has_unit -%}
                      <div class="pc-TrendingCard-unitrow">
                      <p class="pc-TrendingCard-unit">
                        {%- if product.price > t_unit_price -%}<s class="pc-TrendingCard-was">{{ product.price | money_without_trailing_zeros }}</s> {% endif -%}
                        <strong class="pc-TrendingCard-now">{{ t_unit_price | money_without_trailing_zeros }}</strong><span>/ea for {{ t_qty }} items</span>
                      </p>
                      <a href="{{ product.url }}" class="pc-TrendingCard-pricing">Pricing Details</a>
                      </div>
                    {%- endif -%}
                    {%- if t_delivery != blank -%}
                      <p class="pc-TrendingCard-delivery">{{ t_delivery }}</p>
                    {%- endif -%}
                    <div class="pc-TrendingCard-meta">
                      <span class="pc-TrendingCard-price{% if t_has_unit %} has-unit{% endif %}">From {{ product.price | money }}</span>
                      <span class="pc-TrendingCard-noMin">No Minimum</span>
                    </div>
                  </div>
                  <div class="pc-TrendingCard-actions">
                    <a href="{{ product.url }}" class="pc-TrendingCard-btn pc-TrendingCard-btn--design">
                      Start Designing
                    </a>
                  </div>
                </div>
              {% endif %}
            {% endunless %}
          {% endfor %}
        </div>
        <script>
          (function () {
            var track = document.getElementById('TrendingTrack-{{ section.id }}');
            if (!track) return;
            var key = 'sb-favorites';
            function read() {
              try { var v = JSON.parse(window.localStorage.getItem(key) || '[]'); return Array.isArray(v) ? v : []; } catch (e) { return []; }
            }
            function write(list) {
              try { window.localStorage.setItem(key, JSON.stringify(list)); } catch (e) {}
            }
            function paint(btn, on) {
              btn.classList.toggle('is-active', on);
              btn.setAttribute('aria-pressed', on ? 'true' : 'false');
            }
            var saved = read();
            track.querySelectorAll('[data-trending-fav]').forEach(function (btn) {
              paint(btn, saved.indexOf(btn.getAttribute('data-trending-fav')) !== -1);
            });
            track.addEventListener('click', function (e) {
              var fav = e.target.closest('[data-trending-fav]');
              if (fav && track.contains(fav)) {
                var list = read();
                var id = fav.getAttribute('data-trending-fav');
                var at = list.indexOf(id);
                if (at === -1) list.push(id); else list.splice(at, 1);
                write(list);
                paint(fav, at === -1);
                return;
              }
              var more = e.target.closest('[data-trending-more]');
              if (more && track.contains(more)) {
                var box = more.closest('[data-trending-colors]');
                var open = box.classList.toggle('is-expanded');
                more.setAttribute('aria-expanded', open ? 'true' : 'false');
                more.textContent = open ? 'Less' : more.getAttribute('data-more-label');
                return;
              }
              var btn = e.target.closest('.pc-TrendingCard-swatch');
              if (!btn || !track.contains(btn)) return;
              var card = btn.closest('[data-trending-card]');
              var img = card && card.querySelector('[data-trending-img]');
              card.querySelectorAll('.pc-TrendingCard-swatch').forEach(function (b) {
                var on = b === btn;
                b.classList.toggle('is-selected', on);
                b.setAttribute('aria-checked', on ? 'true' : 'false');
              });
              var src = btn.getAttribute('data-color-image');
              if (img && src && img.getAttribute('src') !== src) {
                var next = new Image();
                next.onload = next.onerror = function () { img.src = src; img.removeAttribute('srcset'); };
                next.src = src;
              }
            });
          })();
        </script>
      </section>
    {% endif %}

