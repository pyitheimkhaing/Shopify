<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 1. Mobile Read more / Read less interaction for buying guide
    var seoToggle = document.getElementById('SeoContentToggle-{{ section.id }}');
    var seoContent = document.getElementById('SeoContentCollapsible-{{ section.id }}');

    if (seoToggle && seoContent) {
      seoToggle.addEventListener('click', function () {
        var isExpanded = seoToggle.getAttribute('aria-expanded') === 'true';
        var textSpan = seoToggle.querySelector('.pc-SeoContent-toggleText');

        if (isExpanded) {
          seoContent.classList.remove('is-expanded');
          seoToggle.setAttribute('aria-expanded', 'false');
          if (textSpan) textSpan.textContent = 'Read more';
          var headerEl = document.querySelector('#TshirtHub-{{ section.id }} .pc-SeoContent');
          if (headerEl) {
            var rect = headerEl.getBoundingClientRect();
            if (rect.top < 0) {
              headerEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        } else {
          seoContent.classList.add('is-expanded');
          seoToggle.setAttribute('aria-expanded', 'true');
          if (textSpan) textSpan.textContent = 'Read less';
        }
      });
    }

    // 3. FAQ Accordion interaction
    var faqQuestions = document.querySelectorAll('#TshirtHub-{{ section.id }} .pc-Faqs-faq-question');
    faqQuestions.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var isOpened = btn.classList.contains('isOpened');
        var answer = btn.nextElementSibling;

        if (isOpened) {
          btn.classList.remove('isOpened');
          btn.setAttribute('aria-expanded', 'false');
          if (answer) answer.style.display = 'none';
        } else {
          btn.classList.add('isOpened');
          btn.setAttribute('aria-expanded', 'true');
          if (answer) answer.style.display = 'block';
        }
      });
    });

    // 4. Trending Products Carousel Navigation
    var track = document.getElementById('TrendingTrack-{{ section.id }}');
    var prevBtn = document.getElementById('TrendingPrev-{{ section.id }}');
    var nextBtn = document.getElementById('TrendingNext-{{ section.id }}');

    if (track && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', function () {
        track.scrollBy({ left: -260, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', function () {
        track.scrollBy({ left: 260, behavior: 'smooth' });
      });
    }

    // 5. Phone carousels (Advice & Inspiration, How to Order)
    document.querySelectorAll('#TshirtHub-{{ section.id }} [data-mc-target]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var el = document.getElementById(btn.getAttribute('data-mc-target'));
        if (!el) return;
        var first = el.children[0];
        var gap = parseFloat(getComputedStyle(el).columnGap) || 16;
        var step = first ? first.getBoundingClientRect().width + gap : 260;
        el.scrollBy({ left: step * parseInt(btn.getAttribute('data-mc-dir'), 10), behavior: 'smooth' });
      });
    });
  });
</script>

