{{ 'customink-exact.css' | asset_url | stylesheet_tag }}
{{ 'ci-design.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 or request.design_mode -%}
<section class="cid-section cid-rev" data-cid-reviews {{ section.shopify_attributes }}>
  <div class="cid-wrap">
    {%- if section.settings.heading != blank -%}<h2 class="cid-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="cid-rev__carousel">
        <div class="cid-rev__track">
          {%- for block in section.blocks -%}
            <article class="cid-rev__card" {{ block.shopify_attributes }}>
              <div>
                <div class="cid-rev__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true"{% if i > block.settings.rating %} class="is-off"{% endif %}><path d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.2 1.2-6.5L2.5 9.5l6.6-.9L12 2.6z"/></svg>
                  {%- endfor -%}
                </div>
                <p class="cid-rev__quote">{{ block.settings.text }}</p>
              </div>
              <div class="cid-rev__who">
                <strong>{{ block.settings.name }}</strong>
                {%- if block.settings.detail != blank -%}<span>{{ block.settings.detail }}</span>{%- endif -%}
                {%- if block.settings.time != blank -%}<small class="cid-rev__time">{{ block.settings.time }}</small>{%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>
        <button class="cid-rev__arrow cid-rev__arrow--prev" type="button" aria-label="Previous reviews">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="cid-rev__arrow cid-rev__arrow--next" type="button" aria-label="Next reviews">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      {%- if section.settings.more_link != blank and section.settings.more_label != blank -%}
        <div class="cid-rev__more">
          <a class="cid-pill" href="{{ section.settings.more_link }}">{{ section.settings.more_label }}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="cid-empty">Add "Review" blocks with real customer reviews. This section is hidden on the live store until you do.</p>
    {%- endif -%}
  </div>
</section>
<script src="{{ 'ci-design.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" },
    { "type": "text", "id": "more_label", "label": "Link label", "default": "See All Reviews" },
    { "type": "url", "id": "more_link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text" },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "text", "id": "detail", "label": "Location or company (optional)" },
        { "type": "text", "id": "time", "label": "Date note (optional)", "info": "For example: about 11 hours ago" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
