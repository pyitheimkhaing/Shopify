<section class="fb-page fb-specs" data-fb-panel="specs" hidden>
  <div class="fb-container">
    <div class="fb-spec-block">
      <div class="fb-spec-head">
        <span class="fb-spec-ico" aria-hidden="true">G</span>
        <h2>Graphic Material &amp; Printing</h2>
      </div>
      <div class="fb-spec-table">
        <div class="fb-spec-row"><span class="fb-spec-label">Material</span><span class="fb-spec-value">Premium Polyester</span></div>
        <div class="fb-spec-row"><span class="fb-spec-label">Weight</span><span class="fb-spec-value">7 oz</span></div>
        <div class="fb-spec-row"><span class="fb-spec-label">Print Technology</span><span class="fb-spec-value">1440 DPI Dye Sublimation</span></div>
        <div class="fb-spec-row"><span class="fb-spec-label">Print Sides</span><span class="fb-spec-value">Single-Sided / Double-Sided</span></div>
        <div class="fb-spec-row"><span class="fb-spec-label">Color Configuration</span><span class="fb-spec-value">Front White / Back White</span></div>
        <div class="fb-spec-row"><span class="fb-spec-label">Size Tolerance</span><span class="fb-spec-value">Up to 5 feet: +/- 0.5 inch</span></div>
      </div>
    </div>

    <div class="fb-spec-block">
      <div class="fb-spec-head">
        <span class="fb-spec-ico" aria-hidden="true">C</span>
        <h2>Construction &amp; Finishing</h2>
      </div>
      <div class="fb-spec-table">
        <div class="fb-spec-row"><span class="fb-spec-label">Edge Finish</span><span class="fb-spec-value">Sewn Hems</span></div>
        <div class="fb-spec-row"><span class="fb-spec-label">Mounting Options</span><span class="fb-spec-value">Rust-Resistant Brass Grommets / Pole Pockets</span></div>
        <div class="fb-spec-row"><span class="fb-spec-label">Application</span><span class="fb-spec-value">Indoor &amp; Outdoor</span></div>
        <div class="fb-spec-row"><span class="fb-spec-label">Velcro</span><span class="fb-spec-value">Included for pole pockets &gt; 5 feet</span></div>
      </div>
    </div>

    <div class="fb-spec-block">
      <div class="fb-spec-head">
        <span class="fb-spec-ico" aria-hidden="true">M</span>
        <h2>Care &amp; Maintenance</h2>
      </div>
      <ul class="fb-care-list">
        <li>Machine or hand wash with mild detergent</li>
        <li>Lay flat / line dry / gentle tumble dry</li>
        <li>Iron with paper barrier, never iron soaked fabric</li>
        <li>Keep velcro dry during wash</li>
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FB Specifications",
  "settings": []
}
{% endschema %}
