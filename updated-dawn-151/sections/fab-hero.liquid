{{ 'fab-theme.css' | asset_url | stylesheet_tag }}
{{ 'fidelity.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fab-theme.js' | asset_url }}" defer></script>
<section class="fp-hero">
  {% for i in (1..7) %}<span class="fp-star fp-star--{{ i }}"></span>{% endfor %}
  <span class="fp-shoot" aria-hidden="true"></span>
  {% assign heading_words = section.settings.heading | split: ' ' %}
  {% assign heading_first_line_length = heading_words.size | minus: 1 %}
  {% assign heading_first_line = heading_words | slice: 0, heading_first_line_length | join: ' ' %}
  <h1>{{ heading_first_line }}<br>{{ heading_words | last }} <em>{{ section.settings.heading_emphasis }}</em></h1>
  <p class="fp-hero__sub">{{ section.settings.copy }}</p>
  <div class="fp-hero__ctas">
    <a class="fp-btn fp-btn--gold" href="{{ section.settings.primary_link | default: '/collections/all' }}">{{ section.settings.primary_label }} →</a>
    <a class="fp-btn fp-btn--ghost" href="{{ section.settings.secondary_link | default: '#worlds' }}">{{ section.settings.secondary_label }}</a>
  </div>
  <div class="fp-hero__chips"><span><b>Free preview</b> in 60 seconds</span><span><b>Unlimited</b> free revisions</span><span><b>On time</b> or we make it right</span></div>
</section>
<div class="fp-shelf">
  <figure class="fp-canv">
    <a href="/products/the-unicorn-rider"><img class="fp-canv__art" src="https://fabulousportrait.com/cdn/shop/t/40/assets/fp-hero-canvas-1.webp" alt="The Unicorn Rider" width="514" height="640"></a>
    <span class="fp-canv__before"><img src="https://fabulousportrait.com/cdn/shop/t/40/assets/fp-hero-before-1.webp" alt="" width="240" height="240"><i>Their photo</i></span><span class="fp-canv__arrow">➜</span><figcaption>The Unicorn Rider</figcaption>
  </figure>
  <figure class="fp-canv fp-canv--big fp-canv--cutout">
    <a href="/products/the-dinosaur-rider"><img class="fp-canv__cutout" src="https://fabulousportrait.com/cdn/shop/t/40/assets/fp-hero-boy-dino.webp" alt="The Dinosaur Rider" width="499" height="940"></a>
    <figcaption>The Dinosaur Rider</figcaption>
  </figure>
  <figure class="fp-canv">
    <a href="/products/the-princess"><img class="fp-canv__art" src="https://fabulousportrait.com/cdn/shop/t/40/assets/fp-hero-canvas-3.webp" alt="The Princess" width="514" height="640"></a>
    <span class="fp-canv__before"><img src="https://fabulousportrait.com/cdn/shop/t/40/assets/fp-hero-before-3.webp" alt="" width="240" height="240"><i>Their photo</i></span><span class="fp-canv__arrow">➜</span><figcaption>The Princess</figcaption>
  </figure>
</div>
<div class="fp-hero__chips fp-hero__chips--mobile"><span><b>Free preview</b> in 60 seconds</span><span><b>Unlimited</b> free revisions</span><span><b>On time</b> or we make it right</span></div>
{% schema %}
{"name":"Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SwiftBayPrints"},{"type":"text","id":"heading","label":"Heading","default":"Hang their wildest dream"},{"type":"text","id":"heading_emphasis","label":"Italic emphasis","default":"on their wall"},{"type":"textarea","id":"copy","label":"Copy","default":"Magical canvases made from your photo. Upload once, see the preview free in 60 seconds, and approve every detail before we print."},{"type":"text","id":"primary_label","label":"Primary button","default":"Create their canvas"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Browse the worlds"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"blocks":[{"type":"image","name":"Hero image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"alt","label":"Alt text","default":"Magical portrait"}]}],"presets":[{"name":"Hero","blocks":[{"type":"image"},{"type":"image"},{"type":"image"}]}]}
{% endschema %}
