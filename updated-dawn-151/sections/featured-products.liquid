{{ 'ci-base.css' | asset_url | stylesheet_tag }}
{{ 'customink-exact.css' | asset_url | stylesheet_tag }}
<section class="section products-section">
  <div class="page-width">
    <div class="section-heading split-heading">
      <div><p class="eyebrow eyebrow-dark">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p class="section-intro">{{ section.settings.text }}</p></div>
      <a class="text-link" href="{{ routes.all_products_collection_url }}">Shop all products <span>→</span></a>
    </div>
    <div class="product-grid">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank and collection.products_count > 0 %}
        {% for product in collection.products limit: 4 %}
          <a class="product-card" href="{{ product.url }}">
            <div class="product-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}{% else %}<div class="product-placeholder">SB</div>{% endif %}{% if product.available == false %}<span class="sold-out">Sold out</span>{% endif %}</div>
            <div class="product-info"><div><h3>{{ product.title }}</h3><p>No minimum · Customizable</p></div><strong>{{ product.price_min | money }}</strong></div>
          </a>
        {% endfor %}
      {% else %}
        {% assign products = 'Shortsleeve T-Shirts|Youth T-Shirts|Zip Ups|Premium Hoodies' | split: '|' %}
        {% assign prices = '$11.99|$10.99|$21.52|$28.00' | split: '|' %}
        {% assign images = 'swiftbay-shirt.jpg|swiftbay-shirt-2.jpg|swiftbay-youth.jpg|swiftbay-zip.jpg' | split: '|' %}
        {% for product in products %}
          <a class="product-card" href="{{ routes.all_products_collection_url }}">
            <div class="product-image"><img src="{{ images[forloop.index0] | asset_url }}" alt="{{ product }}" width="700" height="700" loading="lazy"><span class="product-badge">Bestseller</span></div>
            <div class="product-info"><div><h3>{{ product }}</h3><p>No minimum · Customizable</p></div><strong>From {{ prices[forloop.index0] }}</strong></div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "START HERE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our customer favorites" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Kick things off with one of our all-time favorites." },
    { "type": "collection", "id": "collection", "label": "Collection" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
