{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
.section-{{ section.id }}-padding .rich_text_img img {
      width: 100%;
      height: auto;
      display: block;
      margin: 0 auto;
  }
   {% if section.settings.service_bg_img_check %}
  .rich_telt_left_bg.section-{{ section.id }}-padding{
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    background-color: rgba(0,0,0,0);
    background-attachment: inherit;
  }{% endif %}
 {% if section.settings.header_icon %}
.section-{{ section.id }}-padding h2.rich-text__heading_new:after {
    content: "";
    position: absolute;
   background: url(https://cdn.shopify.com/s/files/1/0650/2966/9034/files/673840d547e66c830648a6a8bc9d21bc.svg?v=1745481837) no-repeat;
    bottom: 0;
    left: 50%;
    z-index: 2;
    width: 8rem;
    height: 1rem;
    background-size: contain;
    background-position: right center;
    transform: translate(-50%);
}

.section-{{ section.id }}-padding h2.rich-text__heading_new {
    position: relative;
    padding-bottom: 2rem;
    margin-bottom: 0rem;
}{% endif %}
 .section-{{ section.id }}-padding .rich-text__wrapper_box {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    max-width: 100%;
}

 .section-{{ section.id }}-padding .rich-text__wrapper_li.rich-text__wrapper_right h2.rich-text__heading {
    margin-top: 0;
    text-transform: uppercase;
}

 .section-{{ section.id }}-padding  .rich-text__wrapper_left_menu {
    margin-bottom: 3.2rem;
}
 .section-{{ section.id }}-padding h2.rich-text__wrapper_left_menu__heading.inline-richtext {
    margin: 0;
}

 .section-{{ section.id }}-padding ul.rich-text__wrapper_left_menu__details-content.list-unstyled {
    margin-top: 0.8rem;
}
 .section-{{ section.id }}-padding .list-menu__item--link {
        padding-bottom: 0.2rem;
        padding-top: 0.2rem;
    }
  @media screen and (min-width: 750px) {
    

 .section-{{ section.id }}-padding .rich-text__wrapper_li.rich-text__wrapper_left {
    max-width: 30rem;
    padding-right: 6rem;
    width: 100%;
}

 .section-{{ section.id }}-padding .rich-text__wrapper_li.rich-text__wrapper_right {
    width: calc(100% - 30rem);
}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div class="rich-text content-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} rich-text--full-width content-container--full-width{% endif %} section-{{ section.id }}-padding">
    <div class="rich-text__wrapper rich-text__wrapper--{{ section.settings.desktop_content_position }}{% if section.settings.full_width %} page-width{% endif %}">
      <div class="rich-text__wrapper_box">
      <div class="rich-text__wrapper_li rich-text__wrapper_left pc">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link_list' -%}
                    {%- if block.settings.menu != blank -%}
                      <div class="rich-text__wrapper_left_menu">
                        {%- if block.settings.heading != blank -%}
                          <h2 class="rich-text__wrapper_left_menu__heading inline-richtext h3">{{- block.settings.heading -}}</h2>
                        {%- endif -%}
                      <ul class="rich-text__wrapper_left_menu__details-content list-unstyled">
                        {%- for link in block.settings.menu.links -%}
                          <li>
                            <a
                              href="{{ link.url }}"
                              class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}"
                            >
                              {{ link.title | escape }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                      </div>
                    {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
      <div class="rich-text__wrapper_li rich-text__wrapper_right {{ section.settings.content_alignment }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2
                class="{% if section.settings.header_icon %}rich-text__heading_new{% endif %} rich-text__heading rte inline-richtext {{ block.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.heading }}
              </h2>
        {%- when 'image' -%}
              <div class="{% if block.settings.image_2 != blank %}pc{% endif %} rich_text_img">
                {{
                  block.settings.image
                  | image_url: width: 3840
                  | image_tag:
                    width: block.settings.image.width,
                    height: image_height,
                    class: image_class,
                    sizes: sizes,
                    widths: widths,
                    fetchpriority: fetch_priority
                }}
              </div>
            {%- if block.settings.image_2 != blank -%}
              <div class="app rich_text_img">
                {{
                  block.settings.image_2
                  | image_url: width: 750
                  | image_tag:
                    width: block.settings.image_2.width,
                    height: image_height_2,
                    class: image_class_2,
                    sizes: sizes,
                    widths: widths,
                    fetchpriority: fetch_priority
                }}
              </div>
            {%- endif -%}
            {%- when 'liquid' -%}
               {{ block.settings.custom_liquid }}
            {%- when 'collapsible_row' -%}
            <div
                class="accordion{% if section.settings.layout == 'row' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}"
                {{ block.shopify_attributes }}
              >
                <details
                  id="Details-{{ block.id }}-{{ section.id }}"
                  {% if section.settings.open_first_collapsible_row and forloop.first %}
                    open
                  {% endif %}
                >
                  <summary id="Summary-{{ block.id }}-{{ section.id }}">
                    {% render 'icon-accordion', icon: block.settings.icon %}
                    <h3 class="accordion__title inline-richtext h4">
                      {{ block.settings.heading | default: block.settings.page.title | escape }}
                    </h3>
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </summary>
                  <div
                    class="accordion__content rte"
                    id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                    role="region"
                    aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                  >
                    {{ block.settings.row_content }}
                    {{ block.settings.page.content }}
                  </div>
                </details>
              </div>
            {%- when 'caption' -%}
              <p
                class="rich-text__caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.caption | escape }}
              </p>
            {%- when 'text' -%}
              <div
                class="rich-text__text rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.text }}
              </div>
            {%- when 'button' -%}
              <div
                class="rich-text__buttons{% if block.settings.button_label != blank and block.settings.button_label_2 != blank %} rich-text__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.button_label != blank -%}
                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    {% if block.settings.button_link_2 == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link_2 }}"
                    {% endif %}
                    class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{- block.settings.button_label_2 | escape -}}
                  </a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
