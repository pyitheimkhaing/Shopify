{%- assign related_collection = section.settings.related_collection -%}
{%- if related_collection == blank -%}
  {%- for product_collection in product.collections -%}
    {%- if product_collection.handle contains 'blanket' -%}
      {%- assign related_collection = product_collection -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign related_count = 0 -%}
{%- capture related_cards -%}
  {%- if related_collection != blank -%}
    {%- for related_product in related_collection.products -%}
      {%- if related_product.id != product.id -%}
        <a class="fabulous-blanket__related-card" href="{{ related_product.url }}">
          <span class="fabulous-blanket__related-image">
            {%- if related_product.featured_image != blank -%}
              {{ related_product.featured_image | image_url: width: 680 | image_tag: loading: 'lazy', widths: '300, 450, 680', alt: related_product.title }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
            {%- if related_product.compare_at_price_min > related_product.price_min -%}<span class="fabulous-blanket__related-sale">Sale</span>{%- endif -%}
          </span>
          <span class="fabulous-blanket__related-title">{{ related_product.title | escape }}</span>
          <span class="fabulous-blanket__related-price">{%- if related_product.compare_at_price_min > related_product.price_min -%}<s>{{ related_product.compare_at_price_min | money_with_currency }}</s>{%- endif -%}{% if related_product.price_varies %}From {% endif %}{{ related_product.price_min | money_with_currency }}</span>
        </a>
        {%- assign related_count = related_count | plus: 1 -%}
        {%- if related_count == 4 -%}{%- break -%}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if related_count > 0 -%}
  <div class="fabulous-blanket__related">
    <h2>{{ section.settings.related_heading | escape }}</h2>
    <div class="fabulous-blanket__related-grid">{{ related_cards }}</div>
  </div>
{%- elsif request.design_mode -%}
  <div class="fabulous-blanket__related">
    <p class="fabulous-blanket__related-editor-note">Choose a collection with other published blanket products in the “Related blanket collection” setting to show related products here.</p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Fabulous blanket related",
  "settings": [
    {"type": "collection", "id": "related_collection", "label": "Related blanket collection"},
    {"type": "text", "id": "related_heading", "label": "Related products heading", "default": "More worlds they will love"}
  ],
  "presets": [{"name": "Fabulous blanket related"}]
}
{% endschema %}
