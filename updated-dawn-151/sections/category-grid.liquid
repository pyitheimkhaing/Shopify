{{ 'customink-exact.css' | asset_url | stylesheet_tag }}
{{ 'ci-design.css' | asset_url | stylesheet_tag }}

<section class="cid-section cid-cats" {{ section.shopify_attributes }}>
  <div class="cid-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="cid-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="cid-cats__grid">
        {%- for block in section.blocks -%}
          <a class="cid-cat" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
            <span class="cid-cat__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', sizes: '(min-width: 801px) 300px, 45vw', alt: block.settings.title }}
              {%- elsif block.settings.asset_image != blank -%}
                <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="640" height="525">
              {%- endif -%}
            </span>
            <span class="cid-cat__label">{{ block.settings.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="cid-empty">Add "Category" blocks to show product category tiles.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Custom t-shirts & promotional products for your group" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset_image", "label": "Fallback theme file", "info": "File name in the theme's assets folder, used only when no image is selected above." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Category tiles" }]
}
{% endschema %}
