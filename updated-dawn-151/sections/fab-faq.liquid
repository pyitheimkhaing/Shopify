{{ 'fidelity.css' | asset_url | stylesheet_tag }}
<section class="fp-section faq">
  <div class="fp-wrap"><p class="fp-kicker">Good to know</p><h2 class="fp-sec">Questions parents ask <em>before they order</em></h2>
    <div class="fp-faq">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary><h3>{{ block.settings.question }}</h3></summary><div class="fp-faq__a"><p>{{ block.settings.answer }}</p></div></details>{% endfor %}</div>
    <div class="fp-faq__more"><a href="/pages/faq">Read all questions →</a></div>
  </div>
</section>
{% schema %}{"name":"FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"Questions parents ask before they order"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Do I get a preview before my order is printed?"},{"type":"textarea","id":"answer","label":"Answer","default":"Yes. Every order gets a free preview, and nothing is printed until you approve your design."}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question"},{"type":"question","settings":{"question":"Is my photo good enough to use?","answer":"If it follows our photo guide, it is almost certainly good enough. Every photo is also checked by our team."}},{"type":"question","settings":{"question":"How long does the whole ordering process take?","answer":"Typically 6 to 12 business days in total. You will get a design proof by email within 24 hours."}},{"type":"question","settings":{"question":"What if I don't like the design proof?","answer":"You get unlimited free revisions before anything is printed."}}]}]}{% endschema %}
