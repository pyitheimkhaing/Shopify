{% comment %}
  Live product buy box. Product comes from Shopify's native `product` object on a product
  template (templates/product.fabric-banner.json); the section's "product" setting is only a
  fallback when this section is used on a non-product template.
  Variant is resolved client-side by matching option1/2/3 against the variants JSON below.
{% endcomment %}
{{ 'fabric-banners.css' | asset_url | stylesheet_tag }}
{{ 'fabric-banner-redesign.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="{{ 'fabric-banners.js' | asset_url }}" defer></script>

{% assign opt = 'https://cdn.bestofsigns.com/media/optionvalue/' %}
{%- if product != blank -%}
  {%- assign fb_product = product -%}
{%- else -%}
  {%- assign fb_product = section.settings.product -%}
{%- endif -%}
{%- assign fb_form_id = 'fb-product-form-' | append: section.id -%}
{%- assign fb_media = fb_product.media | where: 'media_type', 'image' -%}
{%- assign fb_featured = fb_product.selected_or_first_available_variant.featured_media -%}
{%- if fb_featured == blank or fb_featured.media_type != 'image' -%}
  {%- assign fb_featured = fb_media.first -%}
{%- endif -%}
{%- assign fb_main_alt = fb_featured.alt | default: fb_product.title | escape -%}
{%- assign fb_start = 0 -%}
{%- for m in fb_media -%}
  {%- if m.id == fb_featured.id -%}{%- assign fb_start = forloop.index0 -%}{%- endif -%}
{%- endfor -%}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section class="fb-page fb-product">
  <div class="fb-container">
    <div class="fb-product__grid">
      <div class="fb-gallery" id="fb-gallery">
        {%- if fb_featured != blank -%}
          <button type="button" class="fb-gallery__main" id="fb-gallery-main" aria-label="Open large product image">
            {{
              fb_featured
              | image_url: width: 1100
              | image_tag:
                id: 'fb-main-image',
                widths: '552, 825, 1100',
                sizes: '(min-width: 990px) 552px, 90vw',
                width: 552,
                height: 500,
                alt: fb_main_alt
            }}
          </button>
          {%- if fb_media.size > 1 -%}
            <div class="fb-thumbs-wrap">
              <button type="button" class="fb-thumbs-btn fb-thumbs-btn--prev" aria-label="Previous image">&lt;</button>
              <ul class="fb-thumbs">
                {%- for m in fb_media -%}
                  {%- assign fb_alt = m.alt | default: fb_product.title | escape -%}
                  <li class="{% if forloop.index0 == fb_start %}is-active{% endif %}"
                    data-src="{{ m | image_url: width: 1100 }}"
                    data-srcset="{{ m | image_url: width: 552 }} 552w, {{ m | image_url: width: 825 }} 825w, {{ m | image_url: width: 1100 }} 1100w"
                    data-full="{{ m | image_url: width: 1600 }}"
                    data-alt="{{ fb_alt }}">
                    {{ m | image_url: width: 160 | image_tag: width: 78, height: 78, loading: 'lazy', alt: fb_alt }}
                  </li>
                {%- endfor -%}
              </ul>
              <button type="button" class="fb-thumbs-btn fb-thumbs-btn--next" aria-label="Next image">&gt;</button>
            </div>
            <ul class="fb-dots">
              {%- for m in fb_media -%}
                <li><button type="button" class="{% if forloop.index0 == fb_start %}is-active{% endif %}" aria-label="Image {{ forloop.index }}"></button></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="fb-options">
        <div class="fb-info-card">
          <nav class="fb-product-crumbs" aria-label="Breadcrumb">
            <a href="{{ routes.root_url }}">Home</a>
            <span aria-hidden="true">/</span>
            <span>Banners</span>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Fabric Banners</span>
          </nav>
          <div class="fb-options__head">
          <div>
            <h1 class="fb-title">Fabric Banners</h1>
            <button type="button" class="fb-rating" data-fb-goto-tab="reviews">
              <span class="fb-stars" aria-hidden="true"><span class="is-on">&#9733;</span><span class="is-on">&#9733;</span><span class="is-on">&#9733;</span><span class="is-on">&#9733;</span><span>&#9733;</span></span>
              <strong>4.4</strong>
              <span class="fb-rating__count">201 reviews</span>
            </button>
            <p class="fb-sr-only">SKU BBRDPF02. In stock.</p>
          </div>
            <div class="fb-share">
              <button type="button" data-fb-share="facebook" aria-label="Share on Facebook">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="2.5"/><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="m8.2 10.9 7.6-4.7M8.2 13.1l7.6 4.7"/></svg>
              </button>
            </div>
          </div>
          <div class="fb-info-delivery">
            <span class="fb-info-delivery__icon" aria-hidden="true">&#128666;</span>
            <span><strong>Delivery Options</strong><small>Rates and availability are confirmed at checkout.</small></span>
          </div>
        </div>

        <div class="fb-size-block">
          <h2 class="fb-size-title">Size Options <span>(W x H)</span></h2>
          <div class="fb-size-row">
            <span class="fb-size-label">Unit</span>
            <div class="fb-unit">
              <button type="button" class="is-active" data-fb-unit="ft" aria-pressed="true">Feet</button>
              <button type="button" data-fb-unit="in" aria-pressed="false">Inch</button>
            </div>
          </div>
          <div class="fb-size-row fb-size-type-row">
            <span class="fb-size-label">Size Type</span>
            <div class="fb-size-type">
              <button type="button" class="is-active" data-fb-size-type="popular" aria-pressed="true">Popular Sizes</button>
              <button type="button" data-fb-size="custom" aria-pressed="false">Custom Size</button>
            </div>
          </div>
          <div class="fb-size-row fb-custom-dims-row">
            <span class="fb-size-label">Custom size <span>(W x H)</span></span>
            <div class="fb-custom-dims">
              <label class="fb-sr-only" for="fb-size-w">Width</label>
              <input id="fb-size-w" type="number" min="1" max="100" value="3">
              <span>x</span>
              <label class="fb-sr-only" for="fb-size-h">Height</label>
              <input id="fb-size-h" type="number" min="1" max="150" value="2">
            </div>
            <p class="fb-custom-size-note">Only configured Shopify sizes can be added to cart.</p>
          </div>
          <p class="fb-size-label fb-popular-label">Popular Sizes <span>(W x H)</span></p>
          <div class="fb-pills">
            <button type="button" class="fb-pill is-active" data-fb-size="3x2">3 x 2</button>
            <button type="button" class="fb-pill" data-fb-size="4x2">4 x 2</button>
            <button type="button" class="fb-pill" data-fb-size="4x3">4 x 3</button>
            <button type="button" class="fb-pill" data-fb-size="6x2">6 x 2</button>
            <button type="button" class="fb-pill" data-fb-size="6x3">6 x 3</button>
            <button type="button" class="fb-pill" data-fb-size="6x4">6 x 4</button>
            <button type="button" class="fb-pill" data-fb-size="8x4">8 x 4</button>
          </div>
        </div>

        <div class="fb-opt-rows">
            <div class="fb-opt-row">
            <button type="button" class="fb-opt-row__head" aria-expanded="false" aria-controls="fb-print-options">
              <span class="fb-opt-row__left">
                <span class="fb-opt-row__label">Print Sides</span>
                <span class="fb-opt-row__value" id="fb-print-value">One side</span>
              </span>
              <span class="fb-opt-row__right">Edit <i class="fb-chevron"></i></span>
            </button>
            <div class="fb-opt-row__body" id="fb-print-options">
              <div class="fb-opt-grid">
                <button type="button" class="fb-opt-card fb-opt-card--print is-active" data-fb-print="one" aria-pressed="true">
                  <span class="fb-print-visual" aria-hidden="true"></span>
                  <span>One Side</span>
                </button>
                <button type="button" class="fb-opt-card fb-opt-card--print" data-fb-print="both" aria-pressed="false">
                  <span class="fb-print-visual" aria-hidden="true"></span>
                  <span>Both Sides</span>
                </button>
              </div>
            </div>
          </div>

          <div class="fb-opt-row">
            <button type="button" class="fb-opt-row__head" aria-expanded="false" aria-controls="fb-mount-options">
              <span class="fb-opt-row__left">
                <span class="fb-opt-row__label">Mounting Options</span>
                <span class="fb-opt-row__value" id="fb-mount-value">Brass grommets</span>
              </span>
              <span class="fb-opt-row__right">Edit <i class="fb-chevron"></i></span>
            </button>
            <div class="fb-opt-row__body" id="fb-mount-options">
              <div class="fb-opt-grid">
                <button type="button" class="fb-opt-card is-active" data-fb-mount="grommets" aria-pressed="true">
                  <img src="{{ opt }}Metal_Grommets_With_Stitched_Edges_1.jpg" alt="Brass grommets" width="80" height="80" loading="lazy">
                  <span>Brass Grommets</span>
                </button>
                <button type="button" class="fb-opt-card" data-fb-mount="none" aria-pressed="false">
                  <img src="{{ opt }}No_Grommets_1_3.jpg" alt="None" width="80" height="80" loading="lazy">
                  <span>None</span>
                </button>
                <button type="button" class="fb-opt-card" data-fb-mount="pockets" aria-pressed="false">
                  <img src="{{ opt }}Pole_Pockets_1.jpg" alt="Pole pockets" width="80" height="80" loading="lazy">
                  <span>Pole Pockets</span>
                </button>
              </div>
            </div>
          </div>

          <div class="fb-opt-row is-hidden" id="fb-pocket-row">
             <button type="button" class="fb-opt-row__head" aria-expanded="false" aria-controls="fb-pocket-options">
              <span class="fb-opt-row__left">
                <span class="fb-opt-row__label">Pole Pockets</span>
                <span class="fb-opt-row__value" id="fb-pocket-value">Top only</span>
              </span>
              <span class="fb-opt-row__right">Edit <i class="fb-chevron"></i></span>
            </button>
             <div class="fb-opt-row__body" id="fb-pocket-options">
              <div class="fb-opt-grid">
                <button type="button" class="fb-opt-card is-active" data-fb-pocket="top" aria-pressed="true">
                  <img src="{{ opt }}Top_Pole_Pockets_1_8.jpg" alt="Top only" width="80" height="80" loading="lazy">
                  <span>Top Only</span>
                </button>
                <button type="button" class="fb-opt-card" data-fb-pocket="tb" aria-pressed="false">
                  <img src="{{ opt }}Top_and_Bottom_Pole_Pockets_1_6.jpg" alt="Top and bottom" width="80" height="80" loading="lazy">
                  <span>Top and Bottom</span>
                </button>
                <button type="button" class="fb-opt-card" data-fb-pocket="lr" aria-pressed="false">
                  <img src="{{ opt }}Left_and_Right_Pole_Pockets_1_5.jpg" alt="Left and right" width="80" height="80" loading="lazy">
                  <span>Left and Right</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="fb-delivery-card">
          <h2 class="fb-ship-title">
            <svg class="fb-ship-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M3 6.5h11.2v10.2H3zM14.2 10h3.3l3.5 3.5v3.2h-6.8z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
              <circle cx="7" cy="18" r="1.8" fill="white" stroke="currentColor" stroke-width="1.7" />
              <circle cx="18" cy="18" r="1.8" fill="white" stroke="currentColor" stroke-width="1.7" />
            </svg>
            <span>Delivery Options</span>
          </h2>
          <div class="fb-ship-grid">
          <button type="button" class="fb-ship-card is-selected" data-fb-ship="standard">
            <div>
              <p class="fb-ship-date">Standard</p>
              <p class="fb-ship-name">Estimated at checkout</p>
            </div>
            <span class="fb-ship-price">At checkout</span>
          </button>
          <button type="button" class="fb-ship-card" data-fb-ship="express">
            <div>
              <p class="fb-ship-date">Express</p>
              <p class="fb-ship-name">Estimated at checkout</p>
            </div>
            <span class="fb-ship-price">At checkout</span>
          </button>
          <button type="button" class="fb-ship-card" data-fb-ship="overnight">
            <div>
              <p class="fb-ship-date">Overnight</p>
              <p class="fb-ship-name">Estimated at checkout</p>
              <span class="fb-ship-badge">Fastest</span>
            </div>
            <span class="fb-ship-price">At checkout</span>
          </button>
          </div>

        </div>

        <div class="fb-quantity-card">
          <div class="fb-quantity-head">
            <h2 class="fb-quantity-title">Quantity</h2>
            <button type="button" class="fb-view-offers" data-fb-open="fb-offers-modal">View offers</button>
          </div>
          <div class="fb-mobile-qty-block" id="fb-mobile-qty-block">
            <div class="fb-mobile-qty-controls">
              <button type="button" class="fb-mobile-qty-btn" id="fb-mobile-qty-minus" aria-label="Decrease quantity">&minus;</button>
              <input type="text" class="fb-mobile-qty-input" id="fb-mobile-qty-val" value="1" inputmode="numeric" aria-label="Quantity" readonly>
              <button type="button" class="fb-mobile-qty-btn" id="fb-mobile-qty-plus" aria-label="Increase quantity">&plus;</button>
            </div>
          </div>
          <div class="fb-artwork-status is-hidden" id="fb-artwork-status">
            <div class="fb-artwork-status__info">
              <svg class="fb-artwork-status__icon" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="20">
                <path d="M4 4a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l4.414 4.414a1 1 0 0 1 .293.707V16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                <path d="M12 2v5a1 1 0 0 0 1 1h5" stroke="currentColor" stroke-width="1.6"/>
              </svg>
              <div class="fb-artwork-status__details">
                <span class="fb-artwork-status__label">Artwork Attached</span>
                <span class="fb-artwork-status__filename" id="fb-artwork-filename"></span>
                <span class="fb-artwork-status__size" id="fb-artwork-filesize"></span>
              </div>
            </div>
            <div class="fb-artwork-status__actions">
              <button type="button" class="fb-artwork-status__btn-change" id="fb-artwork-change" data-fb-open="fb-upload-modal">Change</button>
              <button type="button" class="fb-artwork-status__btn-remove" id="fb-artwork-remove" aria-label="Remove artwork">&times;</button>
            </div>
          </div>
        </div>

        <div class="fb-globo-options" id="fb-globo-options" aria-hidden="true"></div>

        <div class="fb-pricebar" id="proPriceBox">
          <div class="fb-pricebar__each">
            <span>
              <span class="fb-pricebar__old" id="fb-old-each"></span>
              <span id="fb-each-price"></span>
              <span class="fb-discount-note" id="fb-discount-badge"></span>
            </span>
            <button type="button" class="fb-pricebar__details" data-fb-open="fb-price-modal">View pricing details &gt;</button>
          </div>
          {%- if fb_product != blank -%}
            <product-form class="fb-product-form" data-section-id="{{ section.id }}">
              <div class="product-form__error-message-wrapper" role="alert" hidden>
                <span class="product-form__error-message"></span>
              </div>
              {%- form 'product', fb_product, id: fb_form_id, class: 'fb-pricebar__form', novalidate: 'novalidate', data-type: 'add-to-cart-form', enctype: 'multipart/form-data' -%}
                <input type="hidden" name="id" value="{{ fb_product.selected_or_first_available_variant.id }}" id="fb-variant-id" class="product-variant-id">
                <input type="hidden" name="properties[Print Sides]" value="One side" id="fb-prop-print">
                <input type="hidden" name="properties[Mounting]" value="Brass grommets" id="fb-prop-mount">
                <input type="hidden" name="properties[Pole Pocket Placement]" value="" id="fb-prop-pocket" disabled>
                <input type="hidden" name="properties[Delivery Option]" value="Standard requested" id="fb-prop-ship">
                <input type="hidden" name="properties[_fb_width]" value="3" id="fb-prop-width">
                <input type="hidden" name="properties[_fb_height]" value="2" id="fb-prop-height">
                <input type="hidden" name="properties[_fb_unit]" value="Feet" id="fb-prop-unit">
                <input type="hidden" name="properties[_fb_size_type]" value="Popular Size" id="fb-prop-size-type">
                <input type="hidden" name="properties[Custom Width]" value="" id="fb-prop-custom-width" disabled>
                <input type="hidden" name="properties[Custom Height]" value="" id="fb-prop-custom-height" disabled>
                <input type="hidden" name="properties[Custom Unit]" value="" id="fb-prop-custom-unit" disabled>
                <input type="hidden" name="properties[Artwork Status]" value="" id="fb-prop-artwork-status" disabled>
                <input type="hidden" name="properties[Artwork]" value="" id="fb-prop-artwork-existing" disabled>
                <input type="file" name="properties[Artwork]" id="fb-form-artwork" class="visually-hidden" accept="image/jpeg,image/png,image/svg+xml,application/pdf,.ai,.eps" style="display:none;" disabled>
                <div class="fb-pricebar__actions">
                  <div class="fb-qty-total-row">
                    <div class="fb-qty">
                      <button type="button" id="fb-qty-minus" aria-label="Decrease quantity">-</button>
                      <input id="fb-qty" name="quantity" type="text" value="1" inputmode="numeric" aria-label="Quantity">
                      <button type="button" id="fb-qty-plus" aria-label="Increase quantity">+</button>
                    </div>
                    <div class="fb-total" id="fb-total-price"></div>
                  </div>
                  <div class="fb-btns">
                    <button type="button" id="fb-continue-btn" class="fb-btn fb-btn--primary fb-btn--continue">
                      <span>Continue</span>
                    </button>
                    <button type="submit" name="add" id="fb-add-to-cart" class="fb-btn fb-btn--primary" hidden tabindex="-1" aria-hidden="true">
                      <span>{{ 'products.product.add_to_cart' | t }}</span>
                      {%- render 'loading-spinner' -%}
                    </button>
                  </div>
                </div>
              {%- endform -%}
            </product-form>

            <script type="application/json" id="fb-variants-{{ section.id }}">
              [
                {%- for v in fb_product.variants -%}
                  {
                    "id": {{ v.id | json }},
                    "option1": {{ v.option1 | json }},
                    "option2": {{ v.option2 | json }},
                    "option3": {{ v.option3 | json }},
                    "available": {{ v.available | json }},
                    "price": {{ v.price | json }},
                    "price_formatted": {{ v.price | money | json }},
                    "compare_at_price": {{ v.compare_at_price | default: 0 | json }},
                    "compare_at_price_formatted": {{ v.compare_at_price | default: 0 | money | json }}
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            </script>
          {%- else -%}
            <div class="fb-pricebar__actions">
              <p>Select a product for this section in the theme editor.</p>
              <button type="button" class="fb-btn fb-btn--primary" disabled>{{ 'products.product.sold_out' | t }}</button>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

  </div>
</section>

<div class="fb-modal" id="fb-lightbox" role="dialog" aria-modal="true" aria-label="Product image">
  <div class="fb-modal__backdrop"></div>
  <div class="fb-modal__box fb-modal__box--wide">
    <button type="button" class="fb-modal__close" aria-label="Close">&times;</button>
    <button type="button" class="fb-lightbox__zoom" aria-label="Zoom image" aria-pressed="false">+</button>
    <div class="fb-lightbox__stage">
      <img id="fb-lightbox-img" src="{% if fb_featured != blank %}{{ fb_featured | image_url: width: 1600 }}{% endif %}" alt="{{ fb_main_alt }}">
    </div>
  </div>
</div>

<div class="fb-modal" id="fb-price-modal" role="dialog" aria-modal="true" aria-labelledby="fb-price-title">
  <div class="fb-modal__backdrop"></div>
  <div class="fb-modal__box">
    <button type="button" class="fb-modal__close" aria-label="Close">&times;</button>
    <h3 id="fb-price-title">Pricing Details</h3>
    <table class="fb-price-table"><tbody id="fb-price-breakdown"></tbody></table>
    <p class="fb-price-disclaimer">Product prices come from the selected Shopify variant. Delivery and any applicable discounts are calculated at checkout.</p>
  </div>
</div>

<div class="fb-modal" id="fb-offers-modal" role="dialog" aria-modal="true" aria-labelledby="fb-offers-title">
  <div class="fb-modal__backdrop"></div>
  <div class="fb-modal__box fb-offers-modal__box">
    <button type="button" class="fb-modal__close" aria-label="Close offers">&times;</button>
    <h3 id="fb-offers-title">Select Quantity</h3>
    <p class="fb-offers-modal__intro">Choose your quantity to see the current Shopify product subtotal.</p>
    <div class="fb-offers-modal__notice">No quantity offers are currently displayed for this product. Any eligible discount is shown at checkout.</div>
    <div class="fb-offers-modal__quantity">
      <span>Quantity</span>
      <div class="fb-offers-modal__stepper">
        <button type="button" id="fb-offers-minus" aria-label="Decrease offer quantity">&minus;</button>
        <output id="fb-offers-qty">1</output>
        <button type="button" id="fb-offers-plus" aria-label="Increase offer quantity">&plus;</button>
      </div>
    </div>
    <div class="fb-offers-modal__total"><span id="fb-offers-each"></span><strong id="fb-offers-total"></strong></div>
    <button type="button" class="fb-btn fb-btn--primary fb-offers-modal__apply" id="fb-offers-apply">Update quantity</button>
  </div>
</div>

<div class="fb-modal fb-method-modal" id="fb-design-method-modal" role="dialog" aria-modal="true" aria-labelledby="fb-design-method-title">
  <div class="fb-modal__backdrop"></div>
  <div class="fb-modal__box fb-method-modal__box">
    <div class="fb-method-modal__header">
      <h2 id="fb-design-method-title">Select Design Method</h2>
      <button type="button" class="fb-modal__close" aria-label="Close design method">&times;</button>
    </div>
    <div class="fb-method-modal__choices">
      <button type="button" class="fb-method-modal__choice" id="fb-method-design">
        <span class="fb-method-modal__icon" aria-hidden="true">&#9998;</span>
        <span class="fb-method-modal__copy"><strong>Design Online</strong><small>&#10003; Easy customization</small><small>&#10003; Preview your design</small></span>
      </button>
      <button type="button" class="fb-method-modal__choice" id="fb-method-upload">
        <span class="fb-method-modal__icon" aria-hidden="true">&#8682;</span>
        <span class="fb-method-modal__copy"><strong>Upload Artwork</strong><small>&#10003; Attach your print-ready file</small><small>&#10003; Free digital proof</small></span>
      </button>
    </div>
    <button type="button" class="fb-method-modal__skip" id="fb-method-skip">Skip for now, I'll do this later</button>
  </div>
</div>

<div class="fb-modal" id="fb-upload-modal" role="dialog" aria-modal="true" aria-labelledby="fb-upload-title">
  <div class="fb-modal__backdrop"></div>
  <div class="fb-modal__box">
    <button type="button" class="fb-modal__close" aria-label="Close">&times;</button>
    <h3 id="fb-upload-title">Upload artwork</h3>
    <p>Upload your print-ready artwork now, or continue and provide it later. A free digital proof is provided before production.</p>
    <div class="fb-dropzone" id="fb-dropzone">
      <div class="fb-dropzone__icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
      </div>
      <p class="fb-dropzone__prompt">Drag &amp; drop your file here, or <span class="fb-dropzone__browse">browse</span></p>
      <p class="fb-dropzone__hint">Supports JPG, PNG, PDF, SVG, AI, EPS up to 25MB</p>
      <input id="fb-upload-input" type="file" accept="image/jpeg,image/png,image/svg+xml,application/pdf,.ai,.eps">
    </div>
    <div class="fb-upload-error is-hidden" id="fb-upload-error" role="alert"></div>
    <div class="fb-upload-modal-preview is-hidden" id="fb-upload-modal-preview">
      <div class="fb-upload-modal-preview__file">
        <span class="fb-upload-modal-preview__icon">📄</span>
        <div class="fb-upload-modal-preview__meta">
          <span class="fb-upload-modal-preview__name" id="fb-upload-modal-filename"></span>
          <span class="fb-upload-modal-preview__size" id="fb-upload-modal-filesize"></span>
        </div>
      </div>
      <button type="button" class="fb-btn fb-btn--primary fb-btn--sm" id="fb-upload-confirm">Attach Artwork</button>
    </div>
    <div class="fb-upload-guidance">
      <strong>Artwork guidelines</strong>
      <span>JPG, PNG, PDF, SVG, AI, or EPS · maximum 25MB</span>
      <span>Use the highest-resolution file available for your banner size.</span>
    </div>
    <button type="button" class="fb-upload-later" id="fb-upload-later">Upload Later &amp; Continue</button>
  </div>
</div>

<div class="fb-modal" id="fb-design-modal" role="dialog" aria-modal="true" aria-labelledby="fb-design-title">
  <div class="fb-modal__backdrop"></div>
  <div class="fb-modal__box">
    <button type="button" class="fb-modal__close" aria-label="Close">&times;</button>
    <h3 id="fb-design-title">Design online</h3>
    <p>Customize your fabric banner directly with your own text, graphics, colors, and live proof preview.</p>
    <div class="fb-design-modal__content">
      <div class="fb-design-modal__features">
        <div class="fb-design-modal__feat-item">✓ Add custom text, fonts &amp; colors</div>
        <div class="fb-design-modal__feat-item">✓ Upload logos and artwork</div>
        <div class="fb-design-modal__feat-item">✓ Instant online proof before ordering</div>
      </div>
      <button type="button" class="fb-btn fb-btn--primary" id="fb-design-start">Launch Online Designer</button>
      <div class="fb-design-modal__status is-hidden" id="fb-design-status"></div>
    </div>
  </div>
</div>

<div class="fb-toast" id="fb-toast" role="status"></div>

